POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
# Use 0.0.0.0 only for Windows+WSL development so Qlib in WSL can reach PostgreSQL.
POSTGRES_BIND_ADDRESS=127.0.0.1
PIP_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=deb.debian.org/debian
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=38080
# Bound every container's json-file log growth (20 MiB x 5 files by default).
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
# Written by the supported release tool.  Do not hand-edit these values.
QUANTLAB_RELEASE_ID=
QUANTLAB_CONFIG_DIGEST=
QUANTLAB_RELEASE_KIND=
QUANTLAB_RELEASE_ALIAS_OF=
QUANTLAB_CANONICAL_BASELINE=
QUANTLAB_WORKER_RUNTIME_IMAGE_DIGEST=
# Keep DinD layers and the deployment-only digest registry on the data disk,
# outside both the root filesystem and the governed /data/quantlab tree.
RDAGENT_DOCKER_HOST_PATH=/data/quantlab-rdagent-docker
RDAGENT_REGISTRY_HOST_PATH=/data/quantlab-rdagent-registry
RDAGENT_REGISTRY_PORT=55000
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TOKEN=
REQUESTS_PER_MINUTE=99
DOWNLOAD_WORKERS=4
# Bound Qlib feature preprocessing; independent of model training threads.
QUANTLAB_QLIB_KERNELS=1
SCHEDULER_POLL_SECONDS=15
RESEARCH_ASSET_AUTO_ENABLED=true
RESEARCH_ASSET_AUTO_HOUR=20
RESEARCH_ASSET_AUTO_MINUTE=30
HEALTH_SNAPSHOT_SECONDS=300
DATA_FRESHNESS_MAX_DAYS=7
STALE_JOB_HOURS=6
BROKER_FEATURE_ENABLED=false
BROKER_MODE=disabled
BROKER_GATEWAY_URL=
BROKER_HMAC_SECRET=
BROKER_TIMEOUT_SECONDS=10
BROKER_MAX_ORDER_NOTIONAL=1000000
BROKER_MAX_ATTEMPTS=3
# Optional internal webhook receiver for critical alert delivery.
ALERT_WEBHOOK_URL=

# First visit creates the only initial administrator. Set cookie secure=true only
# when an authenticated TLS reverse proxy terminates HTTPS in front of the gateway.
AUTH_MODE=required
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
PLATFORM_SECRET_KEY=

# RD-Agent credentials are passed only to the isolated research worker.
RDAGENT_LLM_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_API_BASE=
CHAT_MODEL=gpt-4.1-mini

# Full RD-Agent deployment identity. The runtime uses a local image ID, while
# every nested execution environment must be a registry reference pinned by
# manifest digest. Release preflight rejects blank values and mutable tags.
RDAGENT_RUNTIME_IMAGE_DIGEST=sha256:<64-hex-image-id>
RDAGENT_QLIB_SANDBOX_IMAGE=registry.example/quantlab-qlib@sha256:<64-hex-digest>
MODEL_SANDBOX_IMAGE=registry.example/quantlab-model@sha256:<64-hex-digest>
