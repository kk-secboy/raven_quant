# URL from the provider. A bare relay base URL is normalized to /api/v1/query.
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TOKEN=replace-me

DATA_ROOT=E:/projects/rdagent-python/data
# Docker deployment only: keep large Parquet/Qlib data on the dedicated host disk.
QUANTLAB_DATA_HOST_PATH=/data/quantlab
DATABASE_URL=postgresql+psycopg://quantlab:change-me@127.0.0.1:55432/quantlab
MLFLOW_TRACKING_URI=postgresql+psycopg://quantlab:change-me@127.0.0.1:55432/quantlab?options=-csearch_path%3Dpublic
REQUESTS_PER_MINUTE=90
DOWNLOAD_WORKERS=4
REQUEST_TIMEOUT_SECONDS=60
MAX_REQUEST_ATTEMPTS=5
RATE_LIMIT_COOLDOWN_SECONDS=180
KEEP_RAW_RESPONSES=true

QLIB_REPO=E:/projects/qlib
QLIB_PYTHON=/mnt/e/venvs/qlib/bin/python
QLIB_WSL_DISTRO=Ubuntu-22.04
QLIB_WORKER_URL=
RUN_EMBEDDED_WORKER=true
SCHEDULER_URL=http://127.0.0.1:8780
SCHEDULER_POLL_SECONDS=15
HEALTH_SNAPSHOT_SECONDS=300
DATA_FRESHNESS_MAX_DAYS=7
STALE_JOB_HOURS=6
BROKER_FEATURE_ENABLED=false
BROKER_MODE=disabled
BROKER_GATEWAY_URL=
BROKER_HMAC_SECRET=
BROKER_TIMEOUT_SECONDS=10
BROKER_MAX_ORDER_NOTIONAL=1000000
BROKER_MAX_ATTEMPTS=3
ALERT_WEBHOOK_URL=
AUTH_MODE=disabled
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# RD-Agent runs are bounded and only enabled when this runtime and its LLM key exist.
RDAGENT_ENABLED=true
RDAGENT_REPO=E:/projects/RD-Agent
RDAGENT_PYTHON=/mnt/e/venvs/rdagent/bin/python
RDAGENT_COMMAND=/mnt/e/venvs/rdagent/bin/rdagent
RDAGENT_WSL_DISTRO=Ubuntu-22.04
RDAGENT_WORKER_URL=
RDAGENT_LLM_KEY_ENV=OPENAI_API_KEY
RDAGENT_MAX_LOOPS=3
RDAGENT_MAX_DURATION=2h
# OPENAI_API_KEY is intentionally not committed. Set it in the runtime secret store.

# External workers may claim only their declared capabilities.
# WORKER_JOB_KINDS=bootstrap,data_verify,data_snapshot,data_qlib,qlib_baseline,supplemental_cn_macro,rdagent_factor
