# Copy to qmt-gateway.env on the Windows machine that runs MiniQMT.
DATABASE_URL=postgresql+psycopg://quantlab:change-me@127.0.0.1:55433/quantlab
BROKER_HMAC_SECRET=replace-with-at-least-32-random-characters

# MiniQMT userdata_mini directory and the sandbox/simulation stock account.
QMT_MINI_PATH=C:\path\to\MiniQMT\userdata_mini
QMT_ACCOUNT_ID=replace-with-provider-sandbox-account-id
QMT_ACCOUNT_REF=QMT-SANDBOX-1
QMT_SESSION_ID=178901
QMT_ENVIRONMENT=sandbox
BROKER_PROVIDER=qmt

# 0.0.0.0 is needed when Docker reaches this Windows process through
# host.docker.internal. Restrict port 8790 with Windows Firewall.
BROKER_GATEWAY_HOST=0.0.0.0
BROKER_GATEWAY_PORT=8790
BROKER_MAX_CLOCK_SKEW_SECONDS=30
BROKER_GATEWAY_POLL_SECONDS=1
BROKER_MAX_SLICE_LATENESS_SECONDS=90
QMT_CANCEL_AFTER_SECONDS=60
QMT_MAX_REPLACEMENTS=1
QMT_MAX_REPRICE_BPS=20
QMT_MINUTE_VOLUME_MULTIPLIER=100
QMT_MAX_QUOTE_AGE_SECONDS=10
