POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
# Use 0.0.0.0 only for Windows+WSL development so Qlib in WSL can reach PostgreSQL.
POSTGRES_BIND_ADDRESS=127.0.0.1
PIP_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=deb.debian.org/debian
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=38080
# Bound every container's json-file log growth (20 MiB x 5 files by default).
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_TOKEN=
REQUESTS_PER_MINUTE=90
DOWNLOAD_WORKERS=4
SCHEDULER_POLL_SECONDS=15
HEALTH_SNAPSHOT_SECONDS=300
DATA_FRESHNESS_MAX_DAYS=7
STALE_JOB_HOURS=6
BROKER_FEATURE_ENABLED=false
BROKER_MODE=disabled
BROKER_GATEWAY_URL=
BROKER_HMAC_SECRET=
BROKER_TIMEOUT_SECONDS=10
BROKER_MAX_ORDER_NOTIONAL=1000000
BROKER_MAX_ATTEMPTS=3
# Optional internal webhook receiver for critical alert delivery.
ALERT_WEBHOOK_URL=

# First visit creates the only initial administrator. Set cookie secure=true only
# when an authenticated TLS reverse proxy terminates HTTPS in front of the gateway.
AUTH_MODE=required
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
PLATFORM_SECRET_KEY=

# RD-Agent credentials are passed only to the isolated research worker.
RDAGENT_LLM_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_API_BASE=
CHAT_MODEL=gpt-4.1-mini
